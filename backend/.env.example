# Life Awakening Backend Environment Template
NODE_ENV=production
PORT=5001

# Dedicated Life Awakening PostgreSQL Database Configuration
DB_USER=lifeapp
DB_HOST=localhost
DB_DATABASE=lifeawakening
DB_PASSWORD=replace_with_your_database_password
DB_PORT=5432
DB_SSL=false
DB_POOL_MAX=20

# Application URLs
FRONTEND_URL=http://13.207.119.57
PORTAL_LOGIN_URL=http://13.207.119.57/login

# Authentication Security (Required)
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key_minimum_32_characters

# Email Service Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="Life Awakening Program <no-reply@your-domain.com>"
RESEND_REPLY_TO=contact@your-domain.com
EMAIL_LIMIT_DELAY_MS=2000

# AWS S3 Storage Configuration
STORAGE_TYPE=s3
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=life-awakening-media-2026
# Leave credentials blank if running on EC2 with an attached IAM Role (recommended)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
